<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="MAC 地址工具" Width="1180" Height="800" MinWidth="860" MinHeight="580"
 WindowStyle="None" ResizeMode="CanResize" Background="{DynamicResource WindowBrush}"
 FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="{DynamicResource BodySize}"
 Foreground="{DynamicResource InkBrush}" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="7" GlassFrameThickness="0" CornerRadius="24"/></shell:WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="WindowBrush" Color="#EDF2F8"/>
  <SolidColorBrush x:Key="SurfaceBrush" Color="#F7FFFFFF"/>
  <SolidColorBrush x:Key="GlassBrush" Color="#BFFFFFFF"/>
  <SolidColorBrush x:Key="FieldBrush" Color="#EFF3F8"/>
  <SolidColorBrush x:Key="InkBrush" Color="#182333"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#6F7D90"/>
  <SolidColorBrush x:Key="LineBrush" Color="#28FFFFFF"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#087BFA"/>
  <SolidColorBrush x:Key="PrimaryBrush" Color="#006CDD"/>
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#E1EFFF"/>
  <SolidColorBrush x:Key="SelectionBrush" Color="#F8FFFFFF"/>
  <SolidColorBrush x:Key="BlueGlow" Color="#599EC8FF"/>
  <SolidColorBrush x:Key="MintGlow" Color="#458DE8D5"/>
  <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="BodySize">16</System:Double>
  <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="SmallSize">13</System:Double>
  <System:Double xmlns:System="clr-namespace:System;assembly=mscorlib" x:Key="HeadingSize">21</System:Double>
  <Style TargetType="TextBlock"><Setter Property="TextTrimming" Value="CharacterEllipsis"/></Style>
  <Style x:Key="Small" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource SmallSize}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/></Style>
  <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontSize" Value="{DynamicResource HeadingSize}"/><Setter Property="FontWeight" Value="Medium"/></Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="CornerRadius" Value="26"/>
   <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="24"/>
   <Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.055" Color="#334A70"/></Setter.Value></Setter>
  </Style>
  <Style x:Key="GlassButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource FieldBrush}"/>
   <Setter Property="Padding" Value="18,8"/><Setter Property="MinHeight" Value="44"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
   <Setter Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1" ScaleY="1"/></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid><Border x:Name="ButtonFace" Background="{TemplateBinding Background}" CornerRadius="22" BorderBrush="#22FFFFFF" BorderThickness="1"/>
     <Border x:Name="Hover" Background="White" CornerRadius="22" Opacity="0"/>
     <Border x:Name="FocusRing" CornerRadius="22" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" Opacity="0"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Opacity" Value="0.85"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource GlassButton}"><Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/></Style>
  <Style x:Key="RoundButton" TargetType="Button" BasedOn="{StaticResource GlassButton}"><Setter Property="Width" Value="42"/><Setter Property="MinHeight" Value="40"/><Setter Property="Padding" Value="0"/><Setter Property="FontSize" Value="18"/></Style>
  <Style x:Key="HeaderButton" TargetType="Button" BasedOn="{StaticResource GlassButton}"><Setter Property="Background" Value="{DynamicResource GlassBrush}"/><Setter Property="FontSize" Value="{DynamicResource SmallSize}"/><Setter Property="Padding" Value="12,6"/><Setter Property="Height" Value="44"/></Style>
  <Style x:Key="CaptionButton" TargetType="Button">
   <Setter Property="Width" Value="38"/><Setter Property="Height" Value="38"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="CaptionFace" Background="{TemplateBinding Background}" CornerRadius="9"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CaptionFace" Property="Background" Value="{DynamicResource GlassBrush}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CaptionFace" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="CaptionFace" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Segment" TargetType="RadioButton">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="SegmentFace" Background="Transparent" CornerRadius="18" Padding="8,2"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SegmentFace" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter TargetName="SegmentFace" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Field" TargetType="TextBox">
   <Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Padding" Value="14,5"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="FieldBorder" CornerRadius="16" Background="{TemplateBinding Background}" BorderThickness="1.5" BorderBrush="Transparent"><ScrollViewer x:Name="PART_ContentHost" Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FieldBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Padding" Value="12,10"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="ToolTip" Value="{Binding}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" CornerRadius="12" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Picker" TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Background" Value="{DynamicResource FieldBrush}"/><Setter Property="MaxDropDownHeight" Value="320"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton IsChecked="{Binding IsDropDownOpen,RelativeSource={RelativeSource TemplatedParent},Mode=TwoWay}" Focusable="False" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource FieldBrush}" CornerRadius="16"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,14,3" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" Margin="14,8,32,8" VerticalAlignment="Center"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
     <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="18" Padding="6" Margin="0,8,0,8" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border>
    </Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Switch" TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal">
   <Grid Width="48" Height="28"><Border x:Name="Track" Background="#C8D0DB" CornerRadius="14"/><Ellipse x:Name="Thumb" Fill="White" Width="22" Height="22" HorizontalAlignment="Left" Margin="3"><Ellipse.RenderTransform><TranslateTransform X="0"/></Ellipse.RenderTransform><Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.12"/></Ellipse.Effect></Ellipse></Grid>
   <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Height" Value="{DynamicResource VendorRowHeight}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="12,3"/><Setter Property="Margin" Value="0,1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="VendorRow" Padding="{TemplateBinding Padding}" CornerRadius="13" Background="Transparent"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="25"/></Grid.ColumnDefinitions><ContentPresenter/><TextBlock x:Name="Check" Grid.Column="1" Text="✓" Foreground="{DynamicResource AccentBrush}" Visibility="Hidden"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="VendorRow" Property="Background" Value="{DynamicResource FieldBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="VendorRow" Property="Background" Value="{DynamicResource AccentSoftBrush}"/><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid x:Name="Viewport" ClipToBounds="True" Background="{DynamicResource WindowBrush}">
  <Canvas IsHitTestVisible="False"><Ellipse Width="650" Height="650" Canvas.Left="-160" Canvas.Top="-260" Fill="{DynamicResource BlueGlow}"><Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect></Ellipse><Ellipse Width="550" Height="550" Canvas.Left="700" Canvas.Top="320" Fill="{DynamicResource MintGlow}"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse></Canvas>
  <Grid x:Name="Design" Margin="0" HorizontalAlignment="Left" VerticalAlignment="Top">
   <Grid.RenderTransform><ScaleTransform x:Name="PageScale"/></Grid.RenderTransform>
   <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="18"/><RowDefinition/></Grid.RowDefinitions>
    <Grid x:Name="Header" Background="Transparent"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Image Source="{Binding Icon,RelativeSource={RelativeSource AncestorType=Window}}" Width="46" Height="46" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"/>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="MAC 地址工具" FontSize="25" FontWeight="SemiBold"/>
       <TextBlock x:Name="ReleaseCredit" Style="{StaticResource Small}"/>
      </StackPanel>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Border Background="{DynamicResource GlassBrush}" CornerRadius="22" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="3" Margin="0,0,12,0"><Grid Width="246" Height="38" x:Name="SizeSegments"><Border x:Name="SizeThumb" Width="82" HorizontalAlignment="Left" Background="{DynamicResource SelectionBrush}" CornerRadius="18"><Border.RenderTransform><TranslateTransform X="82"/></Border.RenderTransform><Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.09"/></Border.Effect></Border><UniformGrid Columns="3"><RadioButton x:Name="Size0" GroupName="FontSize" Content="标准" Style="{StaticResource Segment}"/><RadioButton x:Name="Size1" GroupName="FontSize" Content="大字" IsChecked="True" Style="{StaticResource Segment}"/><RadioButton x:Name="Size2" GroupName="FontSize" Content="更大" Style="{StaticResource Segment}"/></UniformGrid></Grid></Border>
      <Button x:Name="Theme" Content="外观 · 浅色" ToolTip="切换明暗外观" Width="112" Style="{StaticResource HeaderButton}" Margin="0,0,8,0"/>
      <Button x:Name="Motion" Content="动效 · 开" ToolTip="开关动态效果" Width="100" Style="{StaticResource HeaderButton}" Margin="0,0,14,0"/>
      <Button x:Name="Minimize" ToolTip="最小化" AutomationProperties.Name="最小化" Style="{StaticResource CaptionButton}"><Path Data="M 0,6 L 12,6" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="12" Height="12"/></Button>
      <Button x:Name="Maximize" ToolTip="最大化或还原" AutomationProperties.Name="最大化或还原" Style="{StaticResource CaptionButton}"><Path x:Name="MaximizeIcon" Data="M 1,1 L 11,1 11,11 1,11 Z" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="12" Height="12"/></Button>
      <Button x:Name="Close" ToolTip="关闭" AutomationProperties.Name="关闭" Style="{StaticResource CaptionButton}"><Path Data="M 1,1 L 11,11 M 11,1 L 1,11" Stroke="{Binding Foreground,RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Width="12" Height="12"/></Button>
     </StackPanel>
    </Grid>
    <Grid Grid.Row="2" x:Name="MainContent"><Grid.ColumnDefinitions><ColumnDefinition Width="0.40*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="0.60*"/></Grid.ColumnDefinitions>
     <Grid VerticalAlignment="Top"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="186"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Card}"><Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="50"/><RowDefinition Height="43"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="本机网卡" Style="{StaticResource Heading}" VerticalAlignment="Top"/>
       <Button x:Name="Refresh" Content="↻" ToolTip="刷新网卡" Style="{StaticResource RoundButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Width="38" MinHeight="36"/>
       <ComboBox Grid.Row="1" x:Name="Adapters" Style="{StaticResource Picker}" VerticalAlignment="Top" Height="44" AutomationProperties.Name="选择网卡" ToolTip="{Binding SelectedItem,RelativeSource={RelativeSource Self}}"/>
       <CheckBox Grid.Row="2" x:Name="Virtuals" Content="显示虚拟网卡" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
       <TextBlock Grid.Row="3" x:Name="AdapterState" Text="正在读取网卡…" Style="{StaticResource Small}"/>
       <StackPanel Grid.Row="4" Margin="0,8,0,0"><TextBlock Text="当前 MAC" Style="{StaticResource Small}"/><TextBlock x:Name="CurrentMac" Text="—" FontFamily="Consolas" FontWeight="SemiBold" FontSize="26" Margin="0,2,0,0"/></StackPanel>
       <StackPanel Grid.Row="5" Margin="0,10,0,0"><TextBlock x:Name="PermanentLabel" Text="出厂默认地址" ToolTip="由网卡驱动报告的永久 MAC 地址" Style="{StaticResource Small}"/><TextBlock x:Name="PermanentMac" Text="—" FontFamily="Consolas" FontSize="23" Margin="0,2,0,0"/></StackPanel>
      </Grid></Border>
      <Border Grid.Row="2" Style="{StaticResource Card}" Padding="24,20"><Grid><Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="48"/><RowDefinition Height="10"/><RowDefinition/></Grid.RowDefinitions>
       <TextBlock Text="应用与恢复" Style="{StaticResource Heading}"/>
       <Button Grid.Row="1" x:Name="Apply" Content="应用到所选网卡" Style="{StaticResource Primary}"/>
       <UniformGrid Grid.Row="3" Columns="2"><Button x:Name="Reset" Content="恢复默认" Style="{StaticResource GlassButton}" Margin="0,0,5,0"/><Button x:Name="Undo" Content="恢复上次" Style="{StaticResource GlassButton}" Margin="5,0,0,0"/></UniformGrid>
      </Grid></Border>
     </Grid>
     <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top"><Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/><RowDefinition Height="27"/><RowDefinition Height="64"/><RowDefinition Height="32"/><RowDefinition Height="48"/></Grid.RowDefinitions>
      <Grid><TextBlock Text="厂商与地址" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
       <Border HorizontalAlignment="Right" Width="354" Height="40" CornerRadius="20" Background="{DynamicResource FieldBrush}" Padding="3">
        <Grid><Border x:Name="VendorThumb" Background="{DynamicResource SelectionBrush}" HorizontalAlignment="Left" Width="116" CornerRadius="17"><Border.RenderTransform><TranslateTransform/></Border.RenderTransform></Border>
         <UniformGrid Columns="3">
          <RadioButton x:Name="ChooseVendor" Content="自选厂商" GroupName="GenerationMode" IsChecked="True" Style="{StaticResource Segment}"/>
          <RadioButton x:Name="RandomVendor" Content="随机厂商" GroupName="GenerationMode" Style="{StaticResource Segment}"/>
          <RadioButton x:Name="LocalMode" Content="自定义地址" GroupName="GenerationMode" Style="{StaticResource Segment}"/>
         </UniformGrid>
        </Grid>
       </Border>
      </Grid>
      <StackPanel Grid.Row="1" x:Name="VendorTools">
      <Grid Height="42" Margin="0,8,0,2"><TextBox x:Name="Search" Style="{StaticResource Field}" Padding="40,5,14,5" AutomationProperties.Name="搜索厂商"/><Path Data="M 12,5 A 7,7 0 1 1 11.9,5 M 7,17 L 1,23" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.7" Width="22" Height="24" HorizontalAlignment="Left" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock x:Name="SearchHint" Text="搜索厂商，中英文均可" FontSize="{DynamicResource SmallSize}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="43,0,0,0" IsHitTestVisible="False"/></Grid>
      <TextBlock x:Name="VendorCount" Text="正在加载厂商…" Style="{StaticResource Small}" Margin="1,5,0,0"/>
      <ListBox x:Name="Vendors" Background="Transparent" Foreground="{DynamicResource InkBrush}" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="选择厂商"><ListBox.Template><ControlTemplate TargetType="ListBox"><Border Background="{TemplateBinding Background}"><ItemsPresenter/></Border></ControlTemplate></ListBox.Template><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}"/></DataTemplate></ListBox.ItemTemplate></ListBox>
      <Grid Height="32" Margin="0,3,0,3"><Button x:Name="Previous" Content="‹" ToolTip="上一页" Style="{StaticResource RoundButton}" HorizontalAlignment="Left" Width="38" MinHeight="30"/><TextBlock x:Name="PageInfo" Text="0 / 0" FontSize="{DynamicResource SmallSize}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><Button x:Name="Next" Content="›" ToolTip="下一页" Style="{StaticResource RoundButton}" HorizontalAlignment="Right" Width="38" MinHeight="30"/></Grid>
      </StackPanel>
      <TextBlock Grid.Row="2" Text="新 MAC 地址" Style="{StaticResource Small}" VerticalAlignment="Bottom" Margin="0,0,0,6"/>
      <TextBox Grid.Row="3" x:Name="Address" Style="{StaticResource Field}" FontFamily="Consolas" FontWeight="Medium" FontSize="28" CharacterCasing="Upper" MaxLength="32" AutomationProperties.Name="新 MAC 地址"/>
      <TextBlock Grid.Row="4" x:Name="Match" Style="{StaticResource Small}" VerticalAlignment="Center"/>
      <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions><Button x:Name="Generate" Content="按所选厂商生成" Style="{StaticResource Primary}"/><Button Grid.Column="2" x:Name="Copy" Content="复制地址" Style="{StaticResource GlassButton}"/></Grid>
     </Grid></Border>
    </Grid>
   </Grid>
  </Grid>
  <Border x:Name="Toast" Visibility="Collapsed" Opacity="0" Background="#243247" CornerRadius="20" Padding="20,10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"><TextBlock x:Name="ToastText" Foreground="White" FontSize="14"/></Border>
  <Grid x:Name="SheetOverlay" Visibility="Collapsed" Background="#550B1424"><Border Background="{DynamicResource SurfaceBrush}" CornerRadius="30" Width="470" Padding="30" VerticalAlignment="Center" HorizontalAlignment="Center" x:Name="Sheet"><StackPanel><TextBlock x:Name="SheetTitle" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16"/><TextBlock x:Name="SheetText" TextWrapping="Wrap" FontSize="16" LineHeight="26"/><ProgressBar x:Name="SheetProgress" IsIndeterminate="True" Height="4" Margin="0,20,0,0" Visibility="Collapsed" Foreground="{DynamicResource AccentBrush}"/><Grid Margin="0,24,0,0" x:Name="SheetButtons"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="SheetCancel" Content="取消" Style="{StaticResource GlassButton}"/><Button Grid.Column="2" x:Name="SheetConfirm" Content="继续" Style="{StaticResource Primary}"/></Grid></StackPanel></Border></Grid>
 </Grid>
</Window>
